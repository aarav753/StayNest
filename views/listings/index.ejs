<% layout("/layouts/boilerplate") %>
<style>
  
#filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
}

.filter {
    text-align: center;
    margin-top: 15px;
    font-size: 13.5px;
    opacity: 0.7;
}

.filter:hover {
    opacity: 1;
    cursor: pointer;
}

.filter p {
    margin-bottom: 0;
}

.filter a {
    color: inherit;
    text-decoration: none;
}
.filter a:hover {
    color: #0f6dd8;
}
@media (max-width: 991px) {
    #categoryMenu.show {
        position: relative;
        z-index: 10;
        width: 100%;
        height: auto !important;
        overflow: visible !important;
        background: white;
    }

    #categoryMenu.show #filters {
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start;
        width: 100%;
        height: auto !important;
        overflow: visible !important;
        position: relative;
        z-index: 11;
        background: white;
    }

    .row.mt-3 {
        position: relative;
        z-index: 1;
    }
    #categoryMenu.show {
    position: static;
    z-index: auto;
}

#categoryMenu.show #filters {
    background: white;
}

.row.mt-3 {
    margin-top: 1rem !important;
}
}
.taxinfo{
  display: none;
}
.tax-toggle{
  display: flex;
  align-items: center;
  border: 1px solid white;
  background-color:rgba(245, 245, 245, 0.904) ;
  border-radius: 20px;
  width: 230px;
  height:50px;
  justify-content: center;
  text-align: center;
  margin-left: 70px;
  font-size: 15px;
}
.tax-toggle:hover{
  background-color: gainsboro;
}
</style>
<body>
  

<nav class="navbar bg-body-light border-bottom">
    <div class="container-fluid d-block">

        <button
            class="navbar-toggler d-lg-none mb-3"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#categoryMenu"
            aria-controls="categoryMenu"
            aria-expanded="false"
            aria-label="Toggle categories">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse d-lg-block" id="categoryMenu">
            <div id="filters">
                <div class="filter">
                  <a href="/listings/trending">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p>Trending</p>
                    </a>
                </div>
              

                <div class="filter">
                    <a href="/listings/hotels">
                    <div><i class="fa-solid fa-hotel"></i></div>
                    <p>Hotels</p>
                    </a>
                </div>

                <div class="filter">
                    <a href="/listings/cities">
                    <div><i class="fa-solid fa-city"></i></div>
                    <p>Iconic cities</p>
                </a>
                </div>

                <div class="filter">
                    <a href="/listings/pools">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Amazing pools</p>
                    </a>
                </div>

                <div class="filter">
                    <a href=/listings/mountains>
                        <div><i class="fa-solid fa-mountain"></i></div>
                    <p>Mountains</p>
                    </a>
                </div>

                <div class="filter">
                    <a href="/listings/camping">   
                    <div><i class="fa-solid fa-campground"></i></div>
                    <p>Camping</p>
                    </a>
                </div>

                <div class="filter">
                    <a href="/listings/castles">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p>Castles</p>
                    </a>
                </div>

                <div class="filter">
                    <a href="/listings/beaches">
                    <div><i class="fa-solid fa-umbrella-beach"></i></div>
                    <p>Beaches</p>
                    </a>
                </div>

                <div class="filter">
                    <a href="/listings/farms">
                    <div><i class="fa-solid fa-seedling"></i></div>
                    <p>Farms</p>
                    </a>
                </div>

                
                <div class="tax-toggle">
                    <div class="form-check-reverse form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               id="switchMdLabel"
                               role="switch">
                        <label class="form-check-label" for="switchMdLabel">
                            Display total after taxes
                        </label>
                    </div>
                </div>
            </div>
        </div>

    </div>
</nav>

     
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <%for(let listing of allListings){%>
            <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card"  >
  <img src="<%=listing.image.url%>"
   class="card-img-top"
    alt="listing_image"
     style="height:20rem;">
     <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b>
    <br>
     &#8377;<%=listing.price.toLocaleString("en-IN")%>/ night
     <i class="taxinfo">&nbsp;&nbsp;+18%GST</i></p>
  </div>
</div>
</a>
<%}%>
</div>
</body>
