<%layout("/layouts/boilerplate") %>
<body>
  <script>
    const mapToken="<%=process.env.MAP_TOKEN%>";
    const listing=<%-JSON.stringify(list)%>;
      </script>
  <div class="row mt-3">
    <div class="col-8 offset-3">
    <h3><%=list.title%></h3>
    </div>

<span style="background-color: gainsboro; text-align: center; margin-left: 730px; width: 110px;"class="card col-1 offset-3 show-card listing-card">
    <%= list.category %>
</span>
   <div class="card col-6 offset-3 show-card listing-card">
  <img src="<%=list.image.url%>" class="card-img-top show-img" alt="isting_image">
   
  <div class="card-body">
      <p class="card-text">Owned by <i><%=list.owner.username%></i></p>
       <p class="card-text"><%=list.description%></p>
      <p class="card-text">&#8377;<%=list.price.toLocaleString("en-IN")%></p> 
    <p class="card-text"><%=list.location%></p>
      <p class="card-text"> <%=list.country%></p>
  </div>
</div>
    <br>
  </div>
<%if(currUser && currUser._id.equals(list.owner._id)){%>
   <div class="btns mb-3">
    <a href="/listings/<%=list._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
  <form method="post" action="/listings/<%=list._id%>?_method=DELETE" >
    <button class="btn btn-dark offset-3">Delete</button>
  </form>
  </div>
<%}%>
<%if(currUser){%>
  <div class="col-8 offset-3 mb-3 mt-3">
    <hr>
    <h4>Leave a Review</h4>
      <form method="post" action="/listings/<%=list._id%>/reviews" novalidate class="needs-validation">
 <label for="rating"><b>Rating</b></label>
 <br>
        <fieldset class="starability-heart">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]"value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]"value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

 <div class="mb-3 mt-3">
  <label for="comment" class="form-label">Comments</label>
  <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
  <div class="invalid-feedback">Please enter some comment!</div>
 </div>
 <div class="mb-3 mt-3">
 <button class="btn btn-outline-dark">Submit</button>
 </div>
  </form>
  </div>
  <hr>
 <%}%>
 <%if(list.reviews.length>0){%>
<div class="col-8 offset-3 mb-3 mt-3">
     <p><b>All Reviews</b></p>
     <div class="row">
    <%for(review of list.reviews){%>
      <div class="card col-5 mb-3 ms-3" >
  <div class="card-body">
 <h5 class="card-title">@<%=review.author.username%></h5>
     <p class="card-text"><%=review.comment%></p>
  <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
    </div>
    <%if(currUser && currUser._id.equals(review.author._id)){%>
    <form class="mb-3 mt-2" method="post"  action="/listings/<%=list._id%>/reviews/<%=review._id%>?_method=DELETE">
      <button class="btn btn-sm btn-dark">Delete</button>
    </form>
    <%}%>
    </div>
    <%}%>
     </div>
  </div>
  <%}%>
  <div class="col-8 offset-3 mb-3 ">
    <h3>Where you will be</h3>
    <div id="map"></div>
  </div>
    <script src="/js/map.js"></script>
</body>
 